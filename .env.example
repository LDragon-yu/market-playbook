# Core
APP_NAME=A股复盘与盘前预案
APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000
APP_USERNAME=
APP_PASSWORD=
DATA_DIR=./data

# Tushare (keep secrets only in .env)
TUSHARE_TOKEN=
TUSHARE_BASE_URL=http://api.tushare.pro
TUSHARE_POINTS_TIER=15000

# Overseas market: Alpha Vantage (optional)
ALPHA_VANTAGE_API_KEY=
ALPHA_VANTAGE_SYMBOLS=SPY,QQQ,DIA,SOXX,FXI,KWEB

# OCR: disabled | baidu | vision
OCR_MODE=disabled
BAIDU_OCR_API_KEY=
BAIDU_OCR_SECRET_KEY=

# LLM for intelligence, event decisions and stock Q&A. Any OpenAI-compatible endpoint can replace it.
LLM_ENABLED=false
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=
LLM_MODEL=deepseek-chat

# Optional free minute-data supplement
AKSHARE_ENABLED=false
SEESAW_PAIRS=
# Single-stock intraday sentinel. Enable only after a same-day pre-market plan exists.
MONITOR_ENABLED=false
MONITOR_INTERVAL_SECONDS=60
MONITOR_MAX_SYMBOLS=18

# Single bidirectional channel: Feishu self-built app bot (not a custom webhook).
FEISHU_ENABLED=false
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_ALLOWED_USERS=
FEISHU_NOTIFY_CHAT_ID=
